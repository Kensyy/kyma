# Local dev: `docker compose up -d` starts Postgres matching these defaults.
# Production: point at your managed Postgres host (e.g. Supabase) instead.
DATABASE_URL="postgresql://kyma:kyma_dev@localhost:5432/kyma?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-with-a-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
