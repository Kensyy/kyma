// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(STAFF)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id])
  sessions      Session[]
  accounts      Account[]

  assignedTickets     Ticket[]             @relation("TicketAssignee")
  createdTickets      Ticket[]             @relation("TicketCreatedBy")
  ticketComments      TicketComment[]
  ownedAssets         Asset[]
  assetHistory        AssetHistory[]
  attachments         Attachment[]
  activityLog         ActivityLog[]
  dashboardConfig     DashboardConfig?
  customEntityRecords CustomEntityRecord[]
  notifications       Notification[]

  @@unique([email])
  @@map("user")
}

enum Role {
  ADMIN
  STAFF
  END_USER
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domain schema
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Status and Category are admin-configurable lookup tables shared across
// entity types (Section 5.2) — Priority stays a fixed enum above since
// priority levels don't meaningfully vary per org the way statuses do.
enum EntityType {
  TICKET
  ASSET
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  DATE
  BOOLEAN
}

// Section 5.4 — a separate field-type enum from CustomFieldType above:
// custom entity tables additionally support linking a record to a built-in
// entity, which Ticket/Asset custom fields deliberately don't need.
enum CustomEntityFieldType {
  TEXT
  NUMBER
  SELECT
  DATE
  BOOLEAN
  RELATION
}

// What a RELATION field points at. CUSTOM_ENTITY (added once a real need
// showed up) lets a table relate to another admin-defined table — including
// itself, e.g. an "Employees" table with a "Manager" field pointing back at
// Employees. Section 5.4.
enum RelationTargetType {
  TICKET
  ASSET
  USER
  CUSTOM_ENTITY
}

model Branch {
  id       String  @id @default(cuid())
  name     String
  location String?

  users   User[]
  tickets Ticket[]
  assets  Asset[]

  @@map("branch")
}

model Status {
  id         String     @id @default(cuid())
  entityType EntityType
  label      String
  order      Int
  color      String
  // Marks a "done" state (Resolved/Closed/Retired, ...) — drives SLA-overdue
  // and open-count logic without hardcoding label strings admins can rename.
  isTerminal Boolean    @default(false)

  tickets Ticket[]
  assets  Asset[]

  @@unique([entityType, label])
  @@map("status")
}

model Category {
  id         String     @id @default(cuid())
  entityType EntityType
  label      String
  order      Int

  tickets Ticket[]

  @@unique([entityType, label])
  @@map("category")
}

model AssetType {
  id    String @id @default(cuid())
  label String @unique
  order Int

  assets Asset[]

  @@map("asset_type")
}

// Single-row deployment config — e.g. ticketPrefix renders ticketNumber as
// "KYM-1042"; configurable per deployment.
model AppSettings {
  id           String @id @default(cuid())
  ticketPrefix String @default("KYM")

  @@map("app_settings")
}

model Ticket {
  id           String    @id @default(cuid())
  ticketNumber Int       @unique @default(autoincrement())
  title        String
  description  String
  priority     Priority  @default(MEDIUM)
  slaDueAt     DateTime?
  slaBreached  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  statusId    String
  status      Status    @relation(fields: [statusId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  assigneeId  String?
  assignee    User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User      @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id])

  comments TicketComment[]

  @@index([statusId])
  @@index([assigneeId])
  @@map("ticket")
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comment")
}

model Asset {
  id           String    @id @default(cuid())
  name         String
  serialNumber String?
  location     String?
  purchasedAt  DateTime?

  typeId   String
  type     AssetType @relation(fields: [typeId], references: [id])
  statusId String
  status   Status    @relation(fields: [statusId], references: [id])
  ownerId  String?
  owner    User?     @relation(fields: [ownerId], references: [id])
  branchId String?
  branch   Branch?   @relation(fields: [branchId], references: [id])

  tickets Ticket[]
  history AssetHistory[]

  @@index([statusId])
  @@map("asset")
}

model AssetHistory {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  eventType String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())

  @@index([assetId])
  @@map("asset_history")
}

// Skeleton only — storage backend not yet chosen.
model Attachment {
  id           String     @id @default(cuid())
  entityType   EntityType
  entityId     String
  filename     String
  url          String
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([entityType, entityId])
  @@map("attachment")
}

model ActivityLog {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  actorId    String
  actor      User       @relation(fields: [actorId], references: [id])
  action     String
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@map("activity_log")
}

// In-app only (Milestone 10) — no email delivery, so no external service
// account is needed. entityType/entityId reuse the same polymorphic pattern
// as ActivityLog/Attachment so a notification can link back to whatever
// triggered it (a ticket, an asset, ...).
model Notification {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  entityType EntityType?
  entityId   String?
  read       Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@index([userId, read])
  @@map("notification")
}

model CustomFieldDefinition {
  id         String          @id @default(cuid())
  entityType EntityType
  name       String
  fieldType  CustomFieldType
  options    Json?
  required   Boolean         @default(false)
  order      Int

  values CustomFieldValue[]

  @@map("custom_field_definition")
}

// entityId is polymorphic (a Ticket.id or Asset.id depending on the
// definition's entityType) so it's a plain indexed field, not a Prisma
// relation — resolved in the application layer.
model CustomFieldValue {
  id                String                @id @default(cuid())
  entityId          String
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value             String

  @@unique([entityId, fieldDefinitionId])
  @@index([entityId])
  @@index([fieldDefinitionId])
  @@map("custom_field_value")
}

// Section 5.4 — a whole admin-defined table (e.g. "Maintenance"), standalone
// and first-class alongside Ticket/Asset. Deliberately a parallel set of
// tables rather than a retrofit of CustomFieldDefinition's entity_type enum
// into something dynamic — Ticket/Asset custom fields stay exactly as they
// are above.
model CustomEntityDefinition {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int
  createdAt DateTime @default(now())

  // Which of this table's own fields represents a record when it's shown
  // elsewhere (a relation picker in another table, this table's own detail
  // header). Falls back to the first field by `order` when unset — set to
  // SetNull so deleting that field doesn't break the table, it just falls
  // back again.
  displayFieldId String?                      @unique
  displayField   CustomEntityFieldDefinition? @relation("DisplayField", fields: [displayFieldId], references: [id], onDelete: SetNull)

  fields                 CustomEntityFieldDefinition[] @relation("EntityFields")
  records                CustomEntityRecord[]
  // Fields on OTHER tables whose RELATION points at this table — checked
  // before allowing a delete (Section 9 rule: fail with a clear error
  // rather than silently orphaning another table's field).
  incomingRelationFields CustomEntityFieldDefinition[] @relation("RelationTargetEntity")

  @@map("custom_entity_definition")
}

model CustomEntityFieldDefinition {
  id                     String                  @id @default(cuid())
  entityDefinitionId     String
  entityDefinition       CustomEntityDefinition  @relation("EntityFields", fields: [entityDefinitionId], references: [id], onDelete: Cascade)
  name                   String
  fieldType              CustomEntityFieldType
  options                Json?
  // Only set when fieldType is RELATION — which built-in entity (or, for
  // CUSTOM_ENTITY, which other admin-defined table) this field links a
  // record to.
  relationTarget         RelationTargetType?
  relationTargetEntityId String?
  relationTargetEntity   CustomEntityDefinition? @relation("RelationTargetEntity", fields: [relationTargetEntityId], references: [id])
  required               Boolean                 @default(false)
  order                  Int

  values                    CustomEntityFieldValue[]
  displayFieldForDefinition CustomEntityDefinition?  @relation("DisplayField")

  @@index([entityDefinitionId])
  @@map("custom_entity_field_definition")
}

// One row in an admin-defined table.
model CustomEntityRecord {
  id                 String                 @id @default(cuid())
  entityDefinitionId String
  entityDefinition   CustomEntityDefinition @relation(fields: [entityDefinitionId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          User                   @relation(fields: [createdById], references: [id])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  values CustomEntityFieldValue[]

  @@index([entityDefinitionId])
  @@map("custom_entity_record")
}

// Same EAV shape as CustomFieldValue (Section 5.1) — for a RELATION field,
// value stores the target row's id (a Ticket/Asset/User id depending on the
// field definition's relationTarget).
model CustomEntityFieldValue {
  id                String                      @id @default(cuid())
  recordId          String
  record            CustomEntityRecord          @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fieldDefinitionId String
  fieldDefinition   CustomEntityFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  value             String

  @@unique([recordId, fieldDefinitionId])
  @@index([recordId])
  @@index([fieldDefinitionId])
  @@map("custom_entity_field_value")
}

model DashboardConfig {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  layoutJson Json

  @@map("dashboard_config")
}
